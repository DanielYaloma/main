from datetime import datetime

dates = [
    'Wednesday, October 2, 2002',
    'Friday, 11.10.13',
    'Thursday, 18 August 1977'
]

formats = [
    '%A, %B %d, %Y',
    '%A, %d.%m.%y',     #Привел списки форматов для каждой даты.
    '%A, %d %B %Y'
]

for date_str in dates:
    for fmt in formats:
        try:
            date_obj = datetime.strptime(date_str, fmt)
            print(f'Дата: {date_str} - Объект: {date_obj}')
            break
        except ValueError:
            continue
    else:
        print(f'Не удалось распарсить дату: {date_str}')
